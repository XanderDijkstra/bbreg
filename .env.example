# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/bedriftsdb?sslmode=require

# Auth
SESSION_SECRET=replace-with-32-bytes-of-random-hex
COOKIE_DOMAIN=localhost

# External APIs
OPPLYSNINGEN_SUBSCRIPTION_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@yourdomain.no
RESEND_FROM_NAME=BedriftsDB
RESEND_WEBHOOK_SECRET=

# Cron
CRON_SECRET=replace-with-random-string
ENABLE_LOCAL_CRON=false

# Optional outbound CRM
GHL_API_KEY=
GHL_LOCATION_ID=

# Server
PORT=8787
NODE_ENV=development

# Client (Vite — only VITE_-prefixed vars are exposed to the browser)
VITE_API_BASE=/api
